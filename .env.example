POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
# n8n encrypts stored credentials with this key. Losing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=change-me

# --- Server only (docker compose --profile app up -d) ---
# Public address of the dashboard, e.g. studio.artechsolutions.io (point its DNS A record at the server first)
DOMAIN=studio.example.com
APP_URL=https://studio.example.com
# n8n calls the dashboard container directly
DASHBOARD_URL=http://dashboard:3000
# Any long random string; shared with n8n by `npm run n8n:setup`
AUTOMATION_SECRET=change-me
# From n8n Settings > n8n API, after the first start
N8N_API_KEY=
MAIL_FROM=Studio OS <developers@artechsolutions.io>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=developers@artechsolutions.io
SMTP_PASSWORD=
# GOOGLE_TRANSLATE_API_KEY=
# Host folder n8n creates per project (mounted at /data/projects in the n8n container)
# PROJECTS_DIR=D:/projects
