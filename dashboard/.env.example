# Local Docker Postgres (port 5433). On Vercel, use the Neon pooled URL instead
# (…-pooler.neon.tech/…?sslmode=require) and leave N8N_URL empty.
DATABASE_URL=postgres://studio:change-me@127.0.0.1:5433/studio_os

# n8n: local only. API key from n8n Settings > n8n API (`npm run n8n:setup`, Automations page).
# Do not set N8N_URL on Vercel — production email is SMTP, schedules are Vercel Cron.
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Address people open from email links
APP_URL=http://localhost:3000
MAIL_FROM=Studio OS <developers@artechsolutions.io>
# Shared with n8n through the "Studio OS automation secret" credential. Any long random string.
AUTOMATION_SECRET=

# Real SMTP (Vercel production). Locally, leave unset to send through n8n → Mailpit.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=developers@artechsolutions.io
# SMTP_PASSWORD=

# Vercel Cron sends GET with Authorization: Bearer CRON_SECRET. Can be the same as AUTOMATION_SECRET.
# CRON_SECRET=

# Optional: official Google Cloud Translation instead of the free endpoint
# GOOGLE_TRANSLATE_API_KEY=

# Set to true once the dashboard is served over HTTPS. Not needed on Vercel (always HTTPS).
# COOKIE_SECURE=true

# Cloudflare R2 (S3 API). Uploads go from the browser to R2; 100 MB per file.
# CORS: allow PUT/GET from http://localhost:3000 (and later the Vercel URL).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=artech-studio-os
